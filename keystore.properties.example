# Copy this file to keystore.properties and fill it with your private signing key details.
# keystore.properties is ignored by Git. Do not commit real signing credentials.

storeFile=/absolute/path/to/live-progress-release.jks
storePassword=change-me
keyAlias=live-progress
keyPassword=change-me

# When true, Android Studio debug builds are signed with the same private key.
# This lets your local Run/Debug builds replace your previously installed private build.
# Public builders without your private key still cannot upgrade your installed app.
signDebugWithPrivateKey=true
